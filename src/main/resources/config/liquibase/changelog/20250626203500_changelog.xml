<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20250626203500-1" author="Alphar">
        <createTable tableName="exercise_review">
            <column autoIncrement="true" name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="exercise_version_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="author_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="submitted_at" type="datetime(3)" />

            <!-- Auditing fields -->
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false" />
            </column>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="created_date" type="timestamp">
                <constraints nullable="false" />
            </column>
            <column name="last_modified_by" type="varchar(50)" />
            <column name="last_modified_date" type="datetime(3)" />
        </createTable>

        <createTable tableName="exercise_review_comment">
            <column autoIncrement="true" name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="review_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="component_type" type="varchar(50)">
                <constraints nullable="false" />
            </column>
            <column name="path" type="varchar(512)" />
            <column name="line" type="integer" />
            <column name="body" type="longtext">
                <constraints nullable="false" />
            </column>
            <column name="resolved_at" type="datetime(3)" />
            <column name="author_id" type="bigint">
                <constraints nullable="false" />
            </column>

            <!-- Auditing fields -->
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false" />
            </column>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="created_date" type="timestamp">
                <constraints nullable="false" />
            </column>
            <column name="last_modified_by" type="varchar(50)" />
            <column name="last_modified_date" type="datetime(3)" />
        </createTable>

        <!-- Create indexes -->
        <createIndex indexName="idx_exercise_review_created_date"
            tableName="exercise_review">
            <column name="created_date" />
        </createIndex>

        <createIndex indexName="idx_exercise_review_comment_created_date"
            tableName="exercise_review_comment">
            <column name="created_date" />
        </createIndex>

        <!-- Add foreign key constraints -->
        <addForeignKeyConstraint baseColumnNames="exercise_version_id"
            baseTableName="exercise_review"
            constraintName="fk_exercise_review_exercise_version_id"
            referencedColumnNames="id"
            referencedTableName="exercise_version" />

        <addForeignKeyConstraint baseColumnNames="author_id"
            baseTableName="exercise_review"
            constraintName="fk_exercise_review_author_id"
            referencedColumnNames="id"
            referencedTableName="jhi_user" />

        <addForeignKeyConstraint baseColumnNames="review_id"
            baseTableName="exercise_review_comment"
            constraintName="fk_exercise_review_comment_review_id"
            referencedColumnNames="id"
            referencedTableName="exercise_review" />

        <addForeignKeyConstraint baseColumnNames="author_id"
            baseTableName="exercise_review_comment"
            constraintName="fk_exercise_review_comment_author_id"
            referencedColumnNames="id"
            referencedTableName="jhi_user" />
    </changeSet>
</databaseChangeLog>